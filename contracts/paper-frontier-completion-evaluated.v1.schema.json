{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.trureturing.org/paper/paper-frontier-completion-evaluated.v1.schema.json",
  "title": "Paper frontier completion evaluated v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "status", "frontier_ref", "frontier_state_ref", "paper_id",
    "completion_ref", "pending_ref", "manuscript_plan_ref",
    "manuscript_truth_release_ref", "manuscript_truth_release_digest",
    "formal_claim_count", "informal_item_count", "missing_node_ids", "reason", "replayed"
  ],
  "properties": {
    "schema": { "const": "paper-frontier-completion-evaluated.v1" },
    "status": { "enum": ["pending", "completed"] },
    "frontier_ref": { "$ref": "#/$defs/digest" },
    "frontier_state_ref": { "$ref": "#/$defs/digest" },
    "paper_id": { "type": "string", "minLength": 1, "maxLength": 512 },
    "completion_ref": { "$ref": "#/$defs/optionalDigest" },
    "pending_ref": { "$ref": "#/$defs/optionalDigest" },
    "manuscript_plan_ref": { "$ref": "#/$defs/optionalDigest" },
    "manuscript_truth_release_ref": { "$ref": "#/$defs/optionalDigest" },
    "manuscript_truth_release_digest": { "$ref": "#/$defs/optionalDigest" },
    "formal_claim_count": { "type": "integer", "minimum": 0, "maximum": 512 },
    "informal_item_count": { "type": "integer", "minimum": 0, "maximum": 2048 },
    "missing_node_ids": {
      "type": "array", "uniqueItems": true,
      "items": { "$ref": "#/$defs/digest" }
    },
    "reason": { "enum": ["load-bearing-claims-incomplete", "coherent-truth-release-absent", "frontier-complete"] },
    "replayed": { "type": "boolean" }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "optionalDigest": {
      "oneOf": [
        { "const": "" },
        { "$ref": "#/$defs/digest" }
      ]
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.trureturing.org/paper/paper-frontier-completion-cursor.v1.schema.json",
  "title": "Paper frontier completion cursor v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "frontier_ref", "frontier_state_ref", "completion_ref",
    "manuscript_plan_ref", "manuscript_truth_release_ref",
    "manuscript_truth_release_digest", "completed_at"
  ],
  "properties": {
    "schema": { "const": "paper-frontier-completion-cursor.v1" },
    "frontier_ref": { "$ref": "#/$defs/digest" },
    "frontier_state_ref": { "$ref": "#/$defs/digest" },
    "completion_ref": { "$ref": "#/$defs/digest" },
    "manuscript_plan_ref": { "$ref": "#/$defs/digest" },
    "manuscript_truth_release_ref": { "$ref": "#/$defs/digest" },
    "manuscript_truth_release_digest": { "$ref": "#/$defs/digest" },
    "completed_at": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
  }
}

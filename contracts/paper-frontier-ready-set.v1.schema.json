{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.trureturing.org/paper/paper-frontier-ready-set.v1.schema.json",
  "title": "Paper frontier ready set v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "ready_set_id", "ready_set_content"],
  "properties": {
    "schema": { "const": "paper-frontier-ready-set.v1" },
    "ready_set_id": { "$ref": "#/$defs/digest" },
    "ready_set_content": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "frontier_ref",
        "trigger_node_id",
        "trigger_manifest_ref",
        "frontier_state_ref",
        "ready_nodes",
        "created_at"
      ],
      "properties": {
        "frontier_ref": { "$ref": "#/$defs/digest" },
        "trigger_node_id": { "$ref": "#/$defs/digest" },
        "trigger_manifest_ref": { "$ref": "#/$defs/digest" },
        "frontier_state_ref": { "$ref": "#/$defs/digest" },
        "ready_nodes": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/readyNode" }
        },
        "created_at": { "type": "string", "format": "date-time" }
      }
    }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "readyNode": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dispatch_order",
        "node_id",
        "claim_id",
        "formalization_kind",
        "parallel_wave",
        "priority",
        "next_route"
      ],
      "properties": {
        "dispatch_order": { "type": "integer", "minimum": 1 },
        "node_id": { "$ref": "#/$defs/digest" },
        "claim_id": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,255}$" },
        "formalization_kind": {
          "enum": [
            "definition",
            "prerequisite",
            "structural",
            "main-theorem",
            "sharpness",
            "corollary",
            "counterexample",
            "proof-interface"
          ]
        },
        "parallel_wave": { "type": "integer", "minimum": 1 },
        "priority": { "type": "integer", "minimum": 0, "maximum": 100 },
        "next_route": { "const": "governed-selection" }
      }
    }
  }
}

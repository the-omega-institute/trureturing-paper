{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.trureturing.org/paper/paper-scientific-editing-agent-task-staged.v1.schema.json",
  "title": "Paper scientific editing agent task staged v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "dispatch_ref", "task_ref", "task_path",
    "source_authoring_task_ref", "source_manuscript_ref", "paper_id",
    "theory_program_ref", "phase", "agent_role", "context_mode", "replayed"
  ],
  "properties": {
    "schema": { "const": "paper-scientific-editing-agent-task-staged.v1" },
    "dispatch_ref": { "$ref": "#/$defs/digest" },
    "task_ref": { "$ref": "#/$defs/digest" },
    "task_path": { "type": "string", "minLength": 1, "maxLength": 4096 },
    "source_authoring_task_ref": { "$ref": "#/$defs/digest" },
    "source_manuscript_ref": { "$ref": "#/$defs/digest" },
    "paper_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$" },
    "theory_program_ref": { "$ref": "#/$defs/digest" },
    "phase": { "const": "scientific-editing" },
    "agent_role": { "const": "paper-scientific-editor" },
    "context_mode": { "const": "claim-preserving-edit" },
    "replayed": { "type": "boolean" }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
  }
}

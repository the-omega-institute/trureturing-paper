{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.trureturing.org/paper/paper-theory-audit-request.v1.schema.json",
  "title": "Paper theory audit request v1",
  "description": "A content-addressed request for at least two clean-room theory opinions that cannot reuse the theory-author run, prior verdict history, or unauthorized evidence.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "request_id", "request_content"],
  "properties": {
    "schema": { "const": "paper-theory-audit-request.v1" },
    "request_id": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "request_content": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "theory_program_ref",
        "scope_ref",
        "inventory_ref",
        "theorem_package_ref",
        "paper_id",
        "theory_author_run_ref",
        "minimum_independent_opinions",
        "context_mode",
        "contract",
        "requested_at"
      ],
      "properties": {
        "theory_program_ref": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "scope_ref": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "inventory_ref": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "theorem_package_ref": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "paper_id": { "type": "string", "minLength": 1, "maxLength": 512 },
        "theory_author_run_ref": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "minimum_independent_opinions": { "type": "integer", "minimum": 2, "maximum": 8 },
        "context_mode": { "const": "fresh-theory-review" },
        "contract": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "exact_input_refs",
            "permitted_artifact_families",
            "scientific_tasks",
            "forbidden_shortcuts",
            "required_output_schemas",
            "pass_conditions",
            "fail_conditions"
          ],
          "properties": {
            "exact_input_refs": {
              "type": "array",
              "minItems": 4,
              "maxItems": 4,
              "uniqueItems": true,
              "items": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
            },
            "permitted_artifact_families": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "type": "string", "minLength": 1, "maxLength": 512 }
            },
            "scientific_tasks": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "type": "string", "minLength": 1, "maxLength": 8192 }
            },
            "forbidden_shortcuts": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "type": "string", "minLength": 1, "maxLength": 8192 }
            },
            "required_output_schemas": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "type": "string", "minLength": 1, "maxLength": 512 }
            },
            "pass_conditions": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "type": "string", "minLength": 1, "maxLength": 8192 }
            },
            "fail_conditions": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "type": "string", "minLength": 1, "maxLength": 8192 }
            }
          }
        },
        "requested_at": { "type": "string", "format": "date-time" }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.trureturing.org/paper/paper-research-selection.v1.schema.json",
  "title": "Paper research selection v1",
  "description": "A content-addressed owner or policy selection of one paper claim for bounded formalization. The selected claim remains bound to one exact Paper research input.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "selection_id", "selection_content"],
  "properties": {
    "schema": { "const": "paper-research-selection.v1" },
    "selection_id": { "$ref": "#/$defs/digest" },
    "selection_content": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "truth_release_digest",
        "topology_digest",
        "paper_research_input_ref",
        "intuition_proposal_ref",
        "candidate_paper_ref",
        "literature_research_ref",
        "paper_id",
        "role_in_argument",
        "target",
        "claim_boundary",
        "falsifier",
        "expected_contribution",
        "reuse_api",
        "failure_semantics",
        "verification_budget_ref",
        "selected_by",
        "selected_at",
        "next_truth_release_at"
      ],
      "properties": {
        "truth_release_digest": { "$ref": "#/$defs/digest" },
        "topology_digest": { "$ref": "#/$defs/digest" },
        "paper_research_input_ref": { "$ref": "#/$defs/digest" },
        "intuition_proposal_ref": { "$ref": "#/$defs/digest" },
        "candidate_paper_ref": { "$ref": "#/$defs/digest" },
        "literature_research_ref": { "$ref": "#/$defs/digest" },
        "paper_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "role_in_argument": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192
        },
        "target": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "lemma_statement",
            "lemma_gid_intent",
            "known_dependencies",
            "allowed_assumptions",
            "forbidden_weakenings"
          ],
          "properties": {
            "lemma_statement": {
              "type": "string",
              "minLength": 1,
              "maxLength": 16384
            },
            "lemma_gid_intent": { "$ref": "#/$defs/gid" },
            "known_dependencies": {
              "type": "array",
              "uniqueItems": true,
              "items": { "$ref": "#/$defs/nonempty_text" }
            },
            "allowed_assumptions": {
              "type": "array",
              "uniqueItems": true,
              "items": { "$ref": "#/$defs/nonempty_text" }
            },
            "forbidden_weakenings": {
              "type": "array",
              "uniqueItems": true,
              "items": { "$ref": "#/$defs/nonempty_text" }
            }
          }
        },
        "claim_boundary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192
        },
        "falsifier": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192
        },
        "expected_contribution": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192
        },
        "reuse_api": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/nonempty_text" }
        },
        "failure_semantics": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "counterexample_is_useful",
            "missing_prerequisite_is_reportable"
          ],
          "properties": {
            "counterexample_is_useful": { "type": "boolean" },
            "missing_prerequisite_is_reportable": { "type": "boolean" }
          }
        },
        "verification_budget_ref": { "$ref": "#/$defs/digest" },
        "selected_by": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "selected_at": { "type": "string", "format": "date-time" },
        "next_truth_release_at": { "type": "string", "format": "date-time" }
      }
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "gid": {
      "type": "string",
      "pattern": "^D[0-9]+/S[0-9]+/[A-Za-z0-9_-]+(?:/[A-Za-z0-9_-]+)*(?:\\.[A-Za-z_][A-Za-z0-9_']*)?$"
    },
    "nonempty_text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8192
    }
  }
}

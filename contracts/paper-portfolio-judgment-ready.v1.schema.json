{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.trureturing.org/paper/paper-portfolio-judgment-ready.v1.schema.json",
  "title": "Paper portfolio judgment ready v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "task_ref", "result_ref", "dispatch_ref", "portfolio_ref", "candidate_batch_ref", "cycle_number", "evidence", "decision", "updated_portfolio", "routes", "run_id", "provenance", "admitted_at", "replayed", "dedup_key"],
  "properties": {
    "schema": { "const": "paper-portfolio-judgment-ready.v1" },
    "task_ref": { "$ref": "#/$defs/digest" },
    "result_ref": { "$ref": "#/$defs/digest" },
    "dispatch_ref": { "$ref": "#/$defs/digest" },
    "portfolio_ref": { "$ref": "#/$defs/digest" },
    "candidate_batch_ref": { "$ref": "#/$defs/digest" },
    "cycle_number": { "type": "integer", "minimum": 1 },
    "evidence": { "$ref": "#/$defs/artifact" },
    "decision": { "$ref": "#/$defs/artifact" },
    "updated_portfolio": { "$ref": "#/$defs/artifact" },
    "routes": { "type": "array", "minItems": 2, "maxItems": 5, "uniqueItems": true, "items": { "$ref": "#/$defs/route" } },
    "run_id": { "type": "string", "minLength": 1, "maxLength": 512 },
    "provenance": { "enum": ["produced", "adopted"] },
    "admitted_at": { "type": "string", "format": "date-time" },
    "replayed": { "type": "boolean" },
    "dedup_key": { "type": "string", "minLength": 1, "maxLength": 1024 }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "artifact_ref", "content_path", "envelope_ref", "envelope_path"],
      "properties": {
        "schema": { "type": "string", "pattern": "^[a-z][a-z0-9.-]*\\.v[0-9]+$" },
        "artifact_ref": { "$ref": "#/$defs/digest" },
        "content_path": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "envelope_ref": { "$ref": "#/$defs/digest" },
        "envelope_path": { "type": "string", "minLength": 1, "maxLength": 4096 }
      }
    },
    "route": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rank", "paper_id", "theory_program_ref", "scorecard_ref", "action", "next_route", "reason"],
      "properties": {
        "rank": { "type": "integer", "minimum": 1, "maximum": 5 },
        "paper_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$" },
        "theory_program_ref": { "$ref": "#/$defs/digest" },
        "scorecard_ref": { "$ref": "#/$defs/digest" },
        "action": { "enum": ["promote-to-frontier", "hold", "continue-deepening", "split", "merge", "park", "archive"] },
        "next_route": { "enum": ["frontier-planning", "portfolio-judgment", "theory-deepening", "portfolio-split", "portfolio-merge", "parked", "archived"] },
        "reason": { "type": "string", "minLength": 1, "maxLength": 8192 }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.trureturing.org/paper/paper-theory-deepening-request.v1.schema.json",
  "title": "Paper theory deepening request v1",
  "description": "A content-addressed A2 Codex contract for one bounded abstract-theory iteration on one paper program. Formalization and manuscript production are outside this phase.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "request_id", "request_content"],
  "properties": {
    "schema": { "const": "paper-theory-deepening-request.v1" },
    "request_id": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "request_content": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "theory_program_ref",
        "scope_ref",
        "inventory_ref",
        "prior_theorem_package_refs",
        "paper_id",
        "round",
        "phase",
        "contract",
        "requested_at"
      ],
      "properties": {
        "theory_program_ref": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "scope_ref": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "inventory_ref": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "prior_theorem_package_refs": {
          "type": "array",
          "maxItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
        },
        "paper_id": { "type": "string", "minLength": 1, "maxLength": 512 },
        "round": { "type": "integer", "minimum": 1 },
        "phase": { "const": "A2-theory-deepening" },
        "contract": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "exact_input_refs",
            "permitted_artifact_families",
            "scientific_tasks",
            "forbidden_shortcuts",
            "required_output_schemas",
            "pass_conditions",
            "fail_conditions"
          ],
          "properties": {
            "exact_input_refs": {
              "type": "array",
              "minItems": 3,
              "maxItems": 4,
              "uniqueItems": true,
              "items": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
            },
            "permitted_artifact_families": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "type": "string", "minLength": 1, "maxLength": 512 }
            },
            "scientific_tasks": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "type": "string", "minLength": 1, "maxLength": 8192 }
            },
            "forbidden_shortcuts": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "type": "string", "minLength": 1, "maxLength": 8192 }
            },
            "required_output_schemas": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "type": "string", "minLength": 1, "maxLength": 512 }
            },
            "pass_conditions": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "type": "string", "minLength": 1, "maxLength": 8192 }
            },
            "fail_conditions": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "type": "string", "minLength": 1, "maxLength": 8192 }
            }
          }
        },
        "requested_at": { "type": "string", "format": "date-time" }
      }
    }
  }
}

{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"paper-manuscript-plan.v1","title":"paper-manuscript-plan.v1","description":"A content-addressed manuscript plan with formal theorem-level claims separated structurally from conjectures and informal exposition. Every formal claim names one Paper-certified claim, and the whole plan selects one truth release in which all formal claims must coexist.","type":"object","additionalProperties":false,"required":["schema","paper_id","title","manuscript_truth_release_ref","formal_claims","informal_exposition"],"properties":{"schema":{"const":"paper-manuscript-plan.v1"},"paper_id":{"type":"string","minLength":1,"maxLength":512},"title":{"type":"string","minLength":1,"maxLength":1024},"manuscript_truth_release_ref":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},"formal_claims":{"type":"array","minItems":1,"maxItems":512,"items":{"type":"object","additionalProperties":false,"required":["claim_id","latex_label","claim_kind","certified_claim_ref","statement","role_in_argument"],"properties":{"claim_id":{"type":"string","pattern":"^[A-Za-z][A-Za-z0-9_.:-]{0,127}$"},"latex_label":{"type":"string","pattern":"^[A-Za-z][A-Za-z0-9_.-]*:[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"},"claim_kind":{"type":"string","enum":["theorem","lemma","proposition","corollary"]},"certified_claim_ref":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},"statement":{"type":"string","minLength":1,"maxLength":16384},"role_in_argument":{"type":"string","minLength":1,"maxLength":8192}}}},"informal_exposition":{"type":"array","maxItems":2048,"items":{"type":"object","additionalProperties":false,"required":["item_id","latex_label","item_kind","text","epistemic_status"],"properties":{"item_id":{"type":"string","pattern":"^[A-Za-z][A-Za-z0-9_.:-]{0,127}$"},"latex_label":{"type":"string","pattern":"^[A-Za-z][A-Za-z0-9_.-]*:[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"},"item_kind":{"type":"string","enum":["conjecture","definition","example","remark","motivation","discussion","limitation"]},"text":{"type":"string","minLength":1,"maxLength":32768},"epistemic_status":{"type":"string","enum":["conjectured","explicitly-informal"]}},"allOf":[{"if":{"properties":{"item_kind":{"const":"conjecture"}},"required":["item_kind"]},"then":{"properties":{"epistemic_status":{"const":"conjectured"}}},"else":{"properties":{"epistemic_status":{"const":"explicitly-informal"}}}}]}}}}

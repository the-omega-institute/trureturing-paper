{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.trureturing.org/paper/paper-candidate-merge-proposal.v1.schema.json",
  "title": "Paper candidate merge proposal v1",
  "description": "A content-addressed proposal to unify two distinct paper programs when their theorem packages share a canonical core or one subsumes the other.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "proposal_id", "proposal_content"],
  "properties": {
    "schema": { "const": "paper-candidate-merge-proposal.v1" },
    "proposal_id": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "proposal_content": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_theory_program_ref",
        "target_theory_program_ref",
        "source_theorem_package_ref",
        "target_theorem_package_ref",
        "source_paper_id",
        "target_paper_id",
        "canonical_paper_id",
        "overlap_pairs",
        "unified_abstraction",
        "merge_rationale",
        "proposed_at"
      ],
      "properties": {
        "source_theory_program_ref": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "target_theory_program_ref": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "source_theorem_package_ref": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "target_theorem_package_ref": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "source_paper_id": { "type": "string", "minLength": 1, "maxLength": 512 },
        "target_paper_id": { "type": "string", "minLength": 1, "maxLength": 512 },
        "canonical_paper_id": { "type": "string", "minLength": 1, "maxLength": 512 },
        "overlap_pairs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["source_claim_id", "target_claim_id", "relation", "evidence"],
            "properties": {
              "source_claim_id": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,255}$" },
              "target_claim_id": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,255}$" },
              "relation": { "enum": ["equivalent", "generalizes", "specializes", "shared-core", "incompatible-framing"] },
              "evidence": { "type": "string", "minLength": 40, "maxLength": 16384 }
            }
          }
        },
        "unified_abstraction": { "type": "string", "minLength": 80, "maxLength": 16384 },
        "merge_rationale": { "type": "string", "minLength": 80, "maxLength": 16384 },
        "proposed_at": { "type": "string", "format": "date-time" }
      }
    }
  }
}

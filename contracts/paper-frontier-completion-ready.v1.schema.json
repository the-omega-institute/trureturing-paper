{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.trureturing.org/paper/paper-frontier-completion-ready.v1.schema.json",
  "title": "Paper frontier completion ready v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "frontier_ref", "frontier_state_ref", "paper_id", "completion_ref",
    "manuscript_plan_ref", "manuscript_truth_release_ref",
    "manuscript_truth_release_digest", "formal_claim_count", "informal_item_count",
    "replayed", "dedup_key"
  ],
  "properties": {
    "schema": { "const": "paper-frontier-completion-ready.v1" },
    "frontier_ref": { "$ref": "#/$defs/digest" },
    "frontier_state_ref": { "$ref": "#/$defs/digest" },
    "paper_id": { "type": "string", "minLength": 1, "maxLength": 512 },
    "completion_ref": { "$ref": "#/$defs/digest" },
    "manuscript_plan_ref": { "$ref": "#/$defs/digest" },
    "manuscript_truth_release_ref": { "$ref": "#/$defs/digest" },
    "manuscript_truth_release_digest": { "$ref": "#/$defs/digest" },
    "formal_claim_count": { "type": "integer", "minimum": 1, "maximum": 512 },
    "informal_item_count": { "type": "integer", "minimum": 0, "maximum": 2048 },
    "replayed": { "type": "boolean" },
    "dedup_key": { "type": "string", "minLength": 1, "maxLength": 1024 }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
  }
}

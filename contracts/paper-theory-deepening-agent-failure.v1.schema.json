{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.trureturing.org/paper/paper-theory-deepening-agent-failure.v1.schema.json",
  "title": "Paper theory deepening agent failure v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "task_ref", "result_ref", "paper_id", "theory_program_ref",
    "phase", "status", "summary", "blocker_code", "next_route",
    "run_id", "provenance", "replayed", "dedup_key"
  ],
  "properties": {
    "schema": { "const": "paper-theory-deepening-agent-failure.v1" },
    "task_ref": { "$ref": "#/$defs/digest" },
    "result_ref": { "$ref": "#/$defs/digest" },
    "paper_id": { "$ref": "#/$defs/paper_id" },
    "theory_program_ref": { "$ref": "#/$defs/digest" },
    "phase": { "const": "theory-deepening" },
    "status": { "enum": ["no-progress", "blocked"] },
    "summary": { "type": "string", "minLength": 1, "maxLength": 16384 },
    "blocker_code": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{1,127}$" },
    "next_route": { "enum": ["theory-deepening", "blocked"] },
    "run_id": { "type": "string", "maxLength": 512 },
    "provenance": { "enum": ["produced", "adopted"] },
    "replayed": { "type": "boolean" },
    "dedup_key": { "type": "string", "pattern": "^paper-theory-deepening-failure:v1:sha256:[0-9a-f]{64}$" }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "paper_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$" }
  }
}

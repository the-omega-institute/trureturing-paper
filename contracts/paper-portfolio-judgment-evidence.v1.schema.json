{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.trureturing.org/paper/paper-portfolio-judgment-evidence.v1.schema.json",
  "title": "Paper portfolio judgment evidence v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "evidence_id", "evidence_content"],
  "properties": {
    "schema": { "const": "paper-portfolio-judgment-evidence.v1" },
    "evidence_id": { "$ref": "#/$defs/digest" },
    "evidence_content": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dispatch_ref", "agent_result_ref", "portfolio_ref", "candidate_batch_ref", "cycle_number", "compared_scorecard_refs", "ranked_paper_ids", "pairwise_relations", "portfolio_rationale", "decision_ref", "admitted_at"],
      "properties": {
        "dispatch_ref": { "$ref": "#/$defs/digest" },
        "agent_result_ref": { "$ref": "#/$defs/digest" },
        "portfolio_ref": { "$ref": "#/$defs/digest" },
        "candidate_batch_ref": { "$ref": "#/$defs/digest" },
        "cycle_number": { "type": "integer", "minimum": 1 },
        "compared_scorecard_refs": { "type": "array", "minItems": 2, "maxItems": 5, "uniqueItems": true, "items": { "$ref": "#/$defs/digest" } },
        "ranked_paper_ids": { "type": "array", "minItems": 2, "maxItems": 5, "uniqueItems": true, "items": { "$ref": "#/$defs/paper_id" } },
        "pairwise_relations": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/relation" } },
        "portfolio_rationale": { "type": "string", "minLength": 120, "maxLength": 65536 },
        "decision_ref": { "$ref": "#/$defs/digest" },
        "admitted_at": { "type": "string", "format": "date-time" }
      }
    }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "paper_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$" },
    "relation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["left_paper_id", "right_paper_id", "relation", "preferred_owner_paper_id", "evidence_refs", "theorem_interaction", "novelty_interaction"],
      "properties": {
        "left_paper_id": { "$ref": "#/$defs/paper_id" },
        "right_paper_id": { "$ref": "#/$defs/paper_id" },
        "relation": { "enum": ["distinct", "complementary", "overlapping", "duplicate"] },
        "preferred_owner_paper_id": { "type": "string", "maxLength": 128 },
        "evidence_refs": { "type": "array", "minItems": 2, "maxItems": 16, "uniqueItems": true, "items": { "$ref": "#/$defs/digest" } },
        "theorem_interaction": { "type": "string", "minLength": 60, "maxLength": 32768 },
        "novelty_interaction": { "type": "string", "minLength": 60, "maxLength": 32768 }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.trureturing.org/paper/paper-frontier-completion-pending-ready.v1.schema.json",
  "title": "Paper frontier completion pending ready v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "frontier_ref", "frontier_state_ref", "paper_id", "pending_ref",
    "missing_node_ids", "reason", "replayed", "dedup_key"
  ],
  "properties": {
    "schema": { "const": "paper-frontier-completion-pending-ready.v1" },
    "frontier_ref": { "$ref": "#/$defs/digest" },
    "frontier_state_ref": { "$ref": "#/$defs/digest" },
    "paper_id": { "type": "string", "minLength": 1, "maxLength": 512 },
    "pending_ref": { "$ref": "#/$defs/digest" },
    "missing_node_ids": {
      "type": "array", "uniqueItems": true,
      "items": { "$ref": "#/$defs/digest" }
    },
    "reason": { "enum": ["load-bearing-claims-incomplete", "coherent-truth-release-absent"] },
    "replayed": { "type": "boolean" },
    "dedup_key": { "type": "string", "minLength": 1, "maxLength": 1024 }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
  }
}

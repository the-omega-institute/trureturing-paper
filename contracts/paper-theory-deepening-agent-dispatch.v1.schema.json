{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.trureturing.org/paper/paper-theory-deepening-agent-dispatch.v1.schema.json",
  "title": "Paper theory deepening agent dispatch v1",
  "description": "An immutable bridge from one validated A2 request to the FKST-native Paper agent runtime.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "paper_id", "theory_program_ref", "request_ref", "exact_inputs", "requested_at"],
  "properties": {
    "schema": { "const": "paper-theory-deepening-agent-dispatch.v1" },
    "paper_id": { "$ref": "#/$defs/paper_id" },
    "theory_program_ref": { "$ref": "#/$defs/digest" },
    "request_ref": { "$ref": "#/$defs/digest" },
    "exact_inputs": {
      "type": "array",
      "minItems": 4,
      "maxItems": 64,
      "items": { "$ref": "#/$defs/input" }
    },
    "requested_at": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "paper_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$" },
    "schema_name": { "type": "string", "pattern": "^[a-z][a-z0-9.-]*\\.v[0-9]+$", "maxLength": 512 },
    "repository_path": {
      "type": "string",
      "pattern": "^(artifacts|Papers|work|contracts|docs|src|tools|tests)/[A-Za-z0-9._+@=-]+(?:/[A-Za-z0-9._+@=-]+)*$",
      "maxLength": 4096
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "artifact_ref", "repository_relative_path"],
      "properties": {
        "schema": { "$ref": "#/$defs/schema_name" },
        "artifact_ref": { "$ref": "#/$defs/digest" },
        "repository_relative_path": { "$ref": "#/$defs/repository_path" }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.trureturing.org/paper/paper-portfolio-route-ready.v1.schema.json",
  "title": "Paper portfolio route ready v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "task_ref", "result_ref", "dispatch_ref", "portfolio_ref", "candidate_batch_ref", "cycle_number", "decision_ref", "updated_portfolio_ref", "judgment_evidence_ref", "rank", "paper_id", "theory_program_ref", "scorecard_ref", "action", "next_route", "reason", "dedup_key"],
  "properties": {
    "schema": { "const": "paper-portfolio-route-ready.v1" },
    "task_ref": { "$ref": "#/$defs/digest" },
    "result_ref": { "$ref": "#/$defs/digest" },
    "dispatch_ref": { "$ref": "#/$defs/digest" },
    "portfolio_ref": { "$ref": "#/$defs/digest" },
    "candidate_batch_ref": { "$ref": "#/$defs/digest" },
    "cycle_number": { "type": "integer", "minimum": 1 },
    "decision_ref": { "$ref": "#/$defs/digest" },
    "updated_portfolio_ref": { "$ref": "#/$defs/digest" },
    "judgment_evidence_ref": { "$ref": "#/$defs/digest" },
    "rank": { "type": "integer", "minimum": 1, "maximum": 5 },
    "paper_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$" },
    "theory_program_ref": { "$ref": "#/$defs/digest" },
    "scorecard_ref": { "$ref": "#/$defs/digest" },
    "action": { "enum": ["promote-to-frontier", "hold", "continue-deepening", "split", "merge", "park", "archive"] },
    "next_route": { "enum": ["frontier-planning", "portfolio-judgment", "theory-deepening", "portfolio-split", "portfolio-merge", "parked", "archived"] },
    "reason": { "type": "string", "minLength": 1, "maxLength": 8192 },
    "dedup_key": { "type": "string", "minLength": 1, "maxLength": 1024 }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
  }
}

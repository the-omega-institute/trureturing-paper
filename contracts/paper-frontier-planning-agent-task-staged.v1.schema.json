{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.trureturing.org/paper/paper-frontier-planning-agent-task-staged.v1.schema.json",
  "title": "Paper frontier planning agent task staged v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "dispatch_ref", "task_ref", "task_path", "portfolio_task_ref",
    "portfolio_result_ref", "portfolio_ref", "cycle_number", "paper_id",
    "theory_program_ref", "theorem_package_ref", "scorecard_ref",
    "portfolio_decision_ref", "phase", "agent_role", "context_mode", "replayed"
  ],
  "properties": {
    "schema": { "const": "paper-frontier-planning-agent-task-staged.v1" },
    "dispatch_ref": { "$ref": "#/$defs/digest" },
    "task_ref": { "$ref": "#/$defs/digest" },
    "task_path": { "type": "string", "minLength": 1, "maxLength": 4096 },
    "portfolio_task_ref": { "$ref": "#/$defs/digest" },
    "portfolio_result_ref": { "$ref": "#/$defs/digest" },
    "portfolio_ref": { "$ref": "#/$defs/digest" },
    "cycle_number": { "type": "integer", "minimum": 1 },
    "paper_id": { "$ref": "#/$defs/paperId" },
    "theory_program_ref": { "$ref": "#/$defs/digest" },
    "theorem_package_ref": { "$ref": "#/$defs/digest" },
    "scorecard_ref": { "$ref": "#/$defs/digest" },
    "portfolio_decision_ref": { "$ref": "#/$defs/digest" },
    "phase": { "const": "frontier-planning" },
    "agent_role": { "const": "paper-formalization-frontier-planner" },
    "context_mode": { "const": "promotion-bound-planning" },
    "replayed": { "type": "boolean" }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "paperId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$" }
  }
}

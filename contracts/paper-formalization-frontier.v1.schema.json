{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.trureturing.org/paper/paper-formalization-frontier.v1.schema.json",
  "title": "Paper formalization frontier v1",
  "description": "A content-addressed dependency frontier for every claim in a promoted theorem package, with automatically derived parallel waves and exact research-state binding.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "frontier_id", "frontier_content"],
  "properties": {
    "schema": { "const": "paper-formalization-frontier.v1" },
    "frontier_id": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "frontier_content": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "theory_program_ref",
        "theorem_package_ref",
        "theory_audit_ref",
        "scorecard_ref",
        "portfolio_decision_ref",
        "paper_id",
        "truth_release_digest",
        "topology_digest",
        "paper_research_input_ref",
        "nodes",
        "main_theorem_node_ids",
        "sharpness_node_ids",
        "corollary_node_ids",
        "critical_path_depth",
        "maximum_wave_width",
        "created_at"
      ],
      "properties": {
        "theory_program_ref": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "theorem_package_ref": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "theory_audit_ref": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "scorecard_ref": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "portfolio_decision_ref": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "paper_id": { "type": "string", "minLength": 1, "maxLength": 512 },
        "truth_release_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "topology_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "paper_research_input_ref": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "nodes": {
          "type": "array",
          "minItems": 3,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "node_id",
              "claim_id",
              "title",
              "formalization_kind",
              "theorem_package_kind",
              "informal_statement",
              "formal_statement",
              "dependency_node_ids",
              "parallel_wave",
              "priority",
              "target_lean_package",
              "target_lean_module",
              "acceptance_criterion",
              "initial_status"
            ],
            "properties": {
              "node_id": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
              "claim_id": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,255}$" },
              "title": { "type": "string", "minLength": 1, "maxLength": 1024 },
              "formalization_kind": { "enum": ["definition", "prerequisite", "structural", "main-theorem", "sharpness", "corollary", "counterexample", "proof-interface"] },
              "theorem_package_kind": { "type": "string", "minLength": 1, "maxLength": 128 },
              "informal_statement": { "type": "string", "minLength": 1, "maxLength": 32768 },
              "formal_statement": { "type": "string", "minLength": 20, "maxLength": 32768 },
              "dependency_node_ids": {
                "type": "array",
                "uniqueItems": true,
                "items": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
              },
              "parallel_wave": { "type": "integer", "minimum": 0 },
              "priority": { "type": "integer", "minimum": 0, "maximum": 100 },
              "target_lean_package": { "type": "string", "minLength": 1, "maxLength": 1024 },
              "target_lean_module": { "type": "string", "minLength": 1, "maxLength": 2048 },
              "acceptance_criterion": { "type": "string", "minLength": 20, "maxLength": 16384 },
              "initial_status": { "const": "selection-pending" }
            }
          }
        },
        "main_theorem_node_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
        },
        "sharpness_node_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
        },
        "corollary_node_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
        },
        "critical_path_depth": { "type": "integer", "minimum": 1 },
        "maximum_wave_width": { "type": "integer", "minimum": 1 },
        "created_at": { "type": "string", "format": "date-time" }
      }
    }
  }
}

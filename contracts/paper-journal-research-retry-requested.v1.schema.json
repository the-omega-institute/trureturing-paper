{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.trureturing.org/paper/paper-journal-research-retry-requested.v1.schema.json",
  "title": "Paper journal research retry requested v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "task_ref",
    "result_ref",
    "paper_id",
    "theory_program_ref",
    "blocker_code",
    "next_route",
    "dedup_key"
  ],
  "properties": {
    "schema": {
      "const": "paper-journal-research-retry-requested.v1"
    },
    "task_ref": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "result_ref": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "paper_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "theory_program_ref": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "blocker_code": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "next_route": {
      "const": "journal-research"
    },
    "dedup_key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}

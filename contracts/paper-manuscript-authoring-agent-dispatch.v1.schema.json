{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.trureturing.org/paper/paper-manuscript-authoring-agent-dispatch.v1.schema.json",
  "title": "Paper manuscript authoring agent dispatch v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "evaluation_ref", "claim_manifest_ref", "eligibility_ref",
    "manuscript_plan_ref", "completion_ref", "frontier_ref", "paper_id",
    "theory_program_ref", "scope_ref", "inventory_ref", "theorem_package_ref",
    "theory_audit_ref", "candidate_paper_ref", "literature_research_ref",
    "selected_release_ref", "selected_release_digest", "exact_inputs", "requested_at"
  ],
  "properties": {
    "schema": { "const": "paper-manuscript-authoring-agent-dispatch.v1" },
    "evaluation_ref": { "$ref": "#/$defs/digest" },
    "claim_manifest_ref": { "$ref": "#/$defs/digest" },
    "eligibility_ref": { "$ref": "#/$defs/digest" },
    "manuscript_plan_ref": { "$ref": "#/$defs/digest" },
    "completion_ref": { "$ref": "#/$defs/digest" },
    "frontier_ref": { "$ref": "#/$defs/digest" },
    "paper_id": { "$ref": "#/$defs/paper_id" },
    "theory_program_ref": { "$ref": "#/$defs/digest" },
    "scope_ref": { "$ref": "#/$defs/digest" },
    "inventory_ref": { "$ref": "#/$defs/digest" },
    "theorem_package_ref": { "$ref": "#/$defs/digest" },
    "theory_audit_ref": { "$ref": "#/$defs/digest" },
    "candidate_paper_ref": { "$ref": "#/$defs/digest" },
    "literature_research_ref": { "$ref": "#/$defs/digest" },
    "selected_release_ref": { "$ref": "#/$defs/digest" },
    "selected_release_digest": { "$ref": "#/$defs/digest" },
    "exact_inputs": {
      "type": "array",
      "minItems": 14,
      "maxItems": 14,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/input" }
    },
    "requested_at": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "paper_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$" },
    "schema_name": { "type": "string", "pattern": "^[a-z][a-z0-9.-]*\\.v[0-9]+$" },
    "relative_path": { "type": "string", "pattern": "^[A-Za-z0-9._+@=-]+(?:/[A-Za-z0-9._+@=-]+)*$", "maxLength": 4096 },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "artifact_ref", "repository_relative_path"],
      "properties": {
        "schema": { "$ref": "#/$defs/schema_name" },
        "artifact_ref": { "$ref": "#/$defs/digest" },
        "repository_relative_path": { "$ref": "#/$defs/relative_path" }
      }
    }
  }
}

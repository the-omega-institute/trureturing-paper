{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.trureturing.org/paper/paper-formalization-frontier-ready.v1.schema.json",
  "title": "Paper formalization frontier ready v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "task_ref", "result_ref", "dispatch_ref", "portfolio_task_ref",
    "portfolio_result_ref", "portfolio_ref", "cycle_number", "judgment_evidence_ref",
    "updated_portfolio_ref", "paper_id", "theory_program_ref", "theorem_package_ref",
    "theory_audit_ref", "scorecard_ref", "portfolio_decision_ref", "frontier",
    "initial_state", "initial_node_routes", "run_id", "provenance", "admitted_at",
    "replayed", "dedup_key"
  ],
  "properties": {
    "schema": { "const": "paper-formalization-frontier-ready.v1" },
    "task_ref": { "$ref": "#/$defs/digest" },
    "result_ref": { "$ref": "#/$defs/digest" },
    "dispatch_ref": { "$ref": "#/$defs/digest" },
    "portfolio_task_ref": { "$ref": "#/$defs/digest" },
    "portfolio_result_ref": { "$ref": "#/$defs/digest" },
    "portfolio_ref": { "$ref": "#/$defs/digest" },
    "cycle_number": { "type": "integer", "minimum": 1 },
    "judgment_evidence_ref": { "$ref": "#/$defs/digest" },
    "updated_portfolio_ref": { "$ref": "#/$defs/digest" },
    "paper_id": { "$ref": "#/$defs/paperId" },
    "theory_program_ref": { "$ref": "#/$defs/digest" },
    "theorem_package_ref": { "$ref": "#/$defs/digest" },
    "theory_audit_ref": { "$ref": "#/$defs/digest" },
    "scorecard_ref": { "$ref": "#/$defs/digest" },
    "portfolio_decision_ref": { "$ref": "#/$defs/digest" },
    "frontier": { "$ref": "#/$defs/artifact" },
    "initial_state": { "$ref": "#/$defs/artifact" },
    "initial_node_routes": { "type": "array", "minItems": 1, "maxItems": 128, "items": { "$ref": "#/$defs/route" } },
    "run_id": { "type": "string", "minLength": 1, "maxLength": 512 },
    "provenance": { "enum": ["produced", "adopted"] },
    "admitted_at": { "type": "string", "format": "date-time" },
    "replayed": { "type": "boolean" },
    "dedup_key": { "type": "string", "minLength": 1, "maxLength": 1024 }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "paperId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$" },
    "claimId": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,255}$" },
    "path": { "type": "string", "pattern": "^[A-Za-z0-9._+@=-]+(?:/[A-Za-z0-9._+@=-]+)*$", "maxLength": 4096 },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "artifact_ref", "content_path", "envelope_ref", "envelope_path"],
      "properties": {
        "schema": { "type": "string", "pattern": "^[a-z][a-z0-9.-]*\\.v[0-9]+$" },
        "artifact_ref": { "$ref": "#/$defs/digest" },
        "content_path": { "$ref": "#/$defs/path" },
        "envelope_ref": { "$ref": "#/$defs/digest" },
        "envelope_path": { "$ref": "#/$defs/path" }
      }
    },
    "route": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dispatch_order", "node_id", "claim_id", "formalization_kind", "parallel_wave", "priority", "next_route"],
      "properties": {
        "dispatch_order": { "type": "integer", "minimum": 1 },
        "node_id": { "$ref": "#/$defs/digest" },
        "claim_id": { "$ref": "#/$defs/claimId" },
        "formalization_kind": { "enum": ["definition", "prerequisite", "structural", "main-theorem", "sharpness", "corollary", "counterexample", "proof-interface"] },
        "parallel_wave": { "const": 0 },
        "priority": { "type": "integer", "minimum": 0, "maximum": 100 },
        "next_route": { "const": "governed-selection" }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.trureturing.org/paper/paper-candidate-state.v1.schema.json",
  "title": "Paper candidate state v1",
  "description": "The lifecycle state of one paper theory program inside a multi-paper portfolio. One state may receive at most one lease in a portfolio cycle.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "paper_id",
    "theory_program_ref",
    "phase",
    "priority",
    "completed_cycles",
    "consecutive_no_progress_cycles",
    "last_progress_at",
    "status_reason"
  ],
  "properties": {
    "schema": { "const": "paper-candidate-state.v1" },
    "paper_id": { "type": "string", "minLength": 1, "maxLength": 512 },
    "theory_program_ref": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "phase": {
      "enum": [
        "scope-pending",
        "inventory-pending",
        "theory-deepening",
        "audit-pending",
        "frontier-pending",
        "formalizing",
        "certification-pending",
        "manuscript-pending",
        "parked",
        "archived",
        "done"
      ]
    },
    "priority": { "type": "integer", "minimum": 0, "maximum": 100 },
    "completed_cycles": { "type": "integer", "minimum": 0 },
    "consecutive_no_progress_cycles": { "type": "integer", "minimum": 0 },
    "last_progress_at": { "type": "string", "format": "date-time" },
    "status_reason": { "type": "string", "minLength": 1, "maxLength": 4096 }
  }
}

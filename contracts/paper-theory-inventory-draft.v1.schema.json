{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.trureturing.org/paper/paper-theory-inventory-draft.v1.schema.json",
  "title": "Paper theory inventory draft v1",
  "description": "The sole A1 JSON draft that an FKST-managed Codex inventory agent may write. Repository code validates the theorem DAG and computes the final inventory identity.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "theory_program_ref",
    "scope_ref",
    "inventory_request_ref",
    "paper_id",
    "items",
    "main_theorem_claim_ids",
    "missing_interfaces",
    "stronger_variants",
    "weaker_variants",
    "counterexample_obligations",
    "created_at"
  ],
  "properties": {
    "schema": { "const": "paper-theory-inventory-draft.v1" },
    "theory_program_ref": { "$ref": "#/$defs/digest" },
    "scope_ref": { "$ref": "#/$defs/digest" },
    "inventory_request_ref": { "$ref": "#/$defs/digest" },
    "paper_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$" },
    "items": {
      "type": "array",
      "minItems": 3,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/item" }
    },
    "main_theorem_claim_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/claim_id" }
    },
    "missing_interfaces": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 8192 }
    },
    "stronger_variants": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 8192 }
    },
    "weaker_variants": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 8192 }
    },
    "counterexample_obligations": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 8192 }
    },
    "created_at": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "claim_id": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,255}$" },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claim_id",
        "title",
        "kind",
        "status",
        "statement",
        "dependencies",
        "role_in_argument",
        "required_action"
      ],
      "properties": {
        "claim_id": { "$ref": "#/$defs/claim_id" },
        "title": { "type": "string", "minLength": 1, "maxLength": 1024 },
        "kind": {
          "enum": [
            "definition",
            "lemma",
            "proposition",
            "theorem",
            "corollary",
            "conjecture",
            "counterexample",
            "proof-interface"
          ]
        },
        "status": {
          "enum": [
            "certified-foundation",
            "proposed",
            "missing",
            "weak",
            "proof-gap",
            "supporting",
            "out-of-scope"
          ]
        },
        "statement": { "type": "string", "minLength": 1, "maxLength": 32768 },
        "dependencies": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/claim_id" }
        },
        "role_in_argument": { "type": "string", "minLength": 1, "maxLength": 8192 },
        "required_action": { "type": "string", "minLength": 1, "maxLength": 8192 }
      }
    }
  }
}

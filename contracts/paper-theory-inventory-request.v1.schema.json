{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.trureturing.org/paper/paper-theory-inventory-request.v1.schema.json",
  "title": "Paper theory inventory request v1",
  "description": "An A1 Codex contract for inventorying the complete multi-theorem dependency structure of one paper program without editing the theory.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "request_id", "request_content"],
  "properties": {
    "schema": { "const": "paper-theory-inventory-request.v1" },
    "request_id": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "request_content": {
      "type": "object",
      "additionalProperties": false,
      "required": ["theory_program_ref", "scope_ref", "paper_id", "phase", "contract", "requested_at"],
      "properties": {
        "theory_program_ref": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "scope_ref": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "paper_id": { "type": "string", "minLength": 1, "maxLength": 512 },
        "phase": { "const": "A1-inventory" },
        "contract": {
          "type": "object",
          "additionalProperties": false,
          "required": ["exact_input_refs", "permitted_artifact_families", "scientific_tasks", "forbidden_shortcuts", "required_output_schemas", "pass_conditions", "fail_conditions"],
          "properties": {
            "exact_input_refs": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" } },
            "permitted_artifact_families": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 512 } },
            "scientific_tasks": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 8192 } },
            "forbidden_shortcuts": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 8192 } },
            "required_output_schemas": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 512 } },
            "pass_conditions": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 8192 } },
            "fail_conditions": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 8192 } }
          }
        },
        "requested_at": { "type": "string", "format": "date-time" }
      }
    }
  }
}

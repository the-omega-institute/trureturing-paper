{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.trureturing.org/paper/paper-agent-result-recorded.v1.schema.json",
  "title": "Paper agent result recorded v1",
  "description": "The repository-validated, content-addressed Paper agent result raised by the FKST native Codex department.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "task_ref",
    "result_ref",
    "paper_id",
    "theory_program_ref",
    "phase",
    "agent_role",
    "context_mode",
    "status",
    "summary",
    "outputs",
    "next_route",
    "blocker_code",
    "run_id",
    "provenance",
    "replayed"
  ],
  "properties": {
    "schema": { "const": "paper-agent-result-recorded.v1" },
    "task_ref": { "$ref": "#/$defs/digest" },
    "result_ref": { "$ref": "#/$defs/digest" },
    "paper_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$" },
    "theory_program_ref": { "$ref": "#/$defs/digest" },
    "phase": { "type": "string", "minLength": 1, "maxLength": 256 },
    "agent_role": { "type": "string", "minLength": 1, "maxLength": 256 },
    "context_mode": { "type": "string", "minLength": 1, "maxLength": 256 },
    "status": { "enum": ["completed", "no-progress", "blocked"] },
    "summary": { "type": "string", "minLength": 1, "maxLength": 16384 },
    "outputs": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["schema", "workspace_relative_path", "artifact_ref"],
        "properties": {
          "schema": { "$ref": "#/$defs/schema_name" },
          "workspace_relative_path": { "$ref": "#/$defs/output_path" },
          "artifact_ref": { "$ref": "#/$defs/digest" }
        }
      }
    },
    "next_route": { "type": "string", "minLength": 1, "maxLength": 256 },
    "blocker_code": {
      "oneOf": [
        { "const": "" },
        { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{1,127}$" }
      ]
    },
    "run_id": { "type": "string", "maxLength": 512 },
    "provenance": { "enum": ["produced", "adopted"] },
    "replayed": { "type": "boolean" }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "schema_name": { "type": "string", "pattern": "^[a-z][a-z0-9.-]*\\.v[0-9]+$", "maxLength": 512 },
    "output_path": {
      "type": "string",
      "pattern": "^outputs/[A-Za-z0-9._+@=-]+(?:/[A-Za-z0-9._+@=-]+)*\\.json$",
      "maxLength": 4096
    }
  }
}

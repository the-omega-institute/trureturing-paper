{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.trureturing.org/paper/paper-theory-audit-agent-result-admitted.v1.schema.json",
  "title": "Paper theory audit agent result admitted v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "task_ref", "result_ref", "dispatch_ref", "plan_ref", "paper_id", "theory_program_ref", "audit_request_ref", "reviewer_slot", "reviewer_role", "opinion", "aggregate_status", "missing_task_refs", "audit", "scorecard", "verdict", "passed", "promotion_eligible", "next_route", "run_id", "provenance", "admitted_at", "replayed"],
  "properties": {
    "schema": { "const": "paper-theory-audit-agent-result-admitted.v1" },
    "task_ref": { "$ref": "#/$defs/digest" },
    "result_ref": { "$ref": "#/$defs/digest" },
    "dispatch_ref": { "$ref": "#/$defs/digest" },
    "plan_ref": { "$ref": "#/$defs/digest" },
    "paper_id": { "type": "string" },
    "theory_program_ref": { "$ref": "#/$defs/digest" },
    "audit_request_ref": { "$ref": "#/$defs/digest" },
    "reviewer_slot": { "type": "integer", "minimum": 1, "maximum": 4 },
    "reviewer_role": { "type": "string" },
    "opinion": { "type": "object" },
    "aggregate_status": { "enum": ["waiting", "ready"] },
    "missing_task_refs": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/digest" } },
    "audit": { "type": ["object", "null"] },
    "scorecard": { "type": ["object", "null"] },
    "verdict": { "type": "string" },
    "passed": { "type": "boolean" },
    "promotion_eligible": { "type": "boolean" },
    "next_route": { "type": "string" },
    "run_id": { "type": "string", "minLength": 1, "maxLength": 512 },
    "provenance": { "enum": ["produced", "adopted"] },
    "admitted_at": { "type": "string", "format": "date-time" },
    "replayed": { "type": "boolean" }
  },
  "$defs": { "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" } }
}

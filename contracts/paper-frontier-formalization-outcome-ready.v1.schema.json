{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.trureturing.org/paper/paper-frontier-formalization-outcome-ready.v1.schema.json",
  "title": "Paper frontier formalization outcome ready v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "formalization_request_ref",
    "result_ref",
    "decision_ref",
    "frontier_ref",
    "node_id",
    "claim_id",
    "outcome_class",
    "outcome_disposition",
    "frontier_state_ref",
    "outcome_event_ref",
    "replayed",
    "dedup_key"
  ],
  "properties": {
    "schema": { "const": "paper-frontier-formalization-outcome-ready.v1" },
    "formalization_request_ref": { "$ref": "#/$defs/digest" },
    "result_ref": { "$ref": "#/$defs/digest" },
    "decision_ref": { "$ref": "#/$defs/digest" },
    "frontier_ref": { "$ref": "#/$defs/digest" },
    "node_id": { "$ref": "#/$defs/digest" },
    "claim_id": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,255}$" },
    "outcome_class": { "type": "string", "minLength": 1, "maxLength": 128 },
    "outcome_disposition": {
      "enum": [
        "candidate-produced",
        "counterexample",
        "missing-prerequisite",
        "already-known",
        "proof-search-exhausted"
      ]
    },
    "frontier_state_ref": { "$ref": "#/$defs/digest" },
    "outcome_event_ref": { "$ref": "#/$defs/digest" },
    "replayed": { "type": "boolean" },
    "dedup_key": { "type": "string", "minLength": 1, "maxLength": 1024 }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
  }
}

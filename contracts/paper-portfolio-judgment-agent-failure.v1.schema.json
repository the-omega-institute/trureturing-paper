{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.trureturing.org/paper/paper-portfolio-judgment-agent-failure.v1.schema.json",
  "title": "Paper portfolio judgment agent failure v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "task_ref", "result_ref", "portfolio_ref", "cycle_number", "status", "blocker_code", "summary", "next_route"],
  "properties": {
    "schema": { "const": "paper-portfolio-judgment-agent-failure.v1" },
    "task_ref": { "$ref": "#/$defs/digest" },
    "result_ref": { "$ref": "#/$defs/digest" },
    "portfolio_ref": { "$ref": "#/$defs/digest" },
    "cycle_number": { "type": "integer", "minimum": 1 },
    "status": { "enum": ["no-progress", "blocked"] },
    "blocker_code": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{1,127}$" },
    "summary": { "type": "string", "minLength": 1, "maxLength": 16384 },
    "next_route": { "const": "portfolio-judgment" }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
  }
}

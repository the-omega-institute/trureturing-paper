{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.trureturing.org/paper/paper-portfolio-decision.v1.schema.json",
  "title": "Paper portfolio decision v1",
  "description": "A deterministic cross-paper competition result that ranks at least two audited papers and applies bounded promotion capacity across the batch.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "decision_id", "decision_content"],
  "properties": {
    "schema": { "const": "paper-portfolio-decision.v1" },
    "decision_id": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "decision_content": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "portfolio_ref",
        "candidate_batch_ref",
        "cycle_number",
        "policy",
        "evaluated_scorecard_refs",
        "decisions",
        "decided_at"
      ],
      "properties": {
        "portfolio_ref": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "candidate_batch_ref": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "cycle_number": { "type": "integer", "minimum": 1 },
        "policy": {
          "type": "object",
          "additionalProperties": false,
          "required": ["promotion_capacity", "minimum_compared_papers"],
          "properties": {
            "promotion_capacity": { "type": "integer", "minimum": 1, "maximum": 32 },
            "minimum_compared_papers": { "type": "integer", "minimum": 2, "maximum": 32 }
          }
        },
        "evaluated_scorecard_refs": {
          "type": "array",
          "minItems": 2,
          "maxItems": 32,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
        },
        "decisions": {
          "type": "array",
          "minItems": 2,
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "paper_id",
              "theory_program_ref",
              "scorecard_ref",
              "rank",
              "composite_score",
              "action",
              "reason"
            ],
            "properties": {
              "paper_id": { "type": "string", "minLength": 1, "maxLength": 512 },
              "theory_program_ref": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
              "scorecard_ref": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
              "rank": { "type": "integer", "minimum": 1, "maximum": 32 },
              "composite_score": { "type": "integer", "minimum": 0, "maximum": 130 },
              "action": { "enum": ["promote-to-frontier", "hold", "continue-deepening", "split", "merge", "park", "archive"] },
              "reason": { "type": "string", "minLength": 1, "maxLength": 8192 }
            }
          }
        },
        "decided_at": { "type": "string", "format": "date-time" }
      }
    }
  }
}

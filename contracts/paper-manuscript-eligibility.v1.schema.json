{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"paper-manuscript-eligibility.v1","title":"paper-manuscript-eligibility.v1","description":"Pass receipt for the manuscript claim gate. It is emitted only when every formal claim is certified, all formal claims coexist in the selected truth release, and informal epistemic boundaries are explicit.","type":"object","additionalProperties":false,"required":["schema","manuscript_plan_ref","claim_manifest_ref","paper_id","manuscript_truth_release_ref","manuscript_truth_release_digest","formal_claim_count","informal_item_count","formal_claims_certified","exact_release_coherent","epistemic_boundaries_explicit","status"],"properties":{"schema":{"const":"paper-manuscript-eligibility.v1"},"manuscript_plan_ref":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},"claim_manifest_ref":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},"paper_id":{"type":"string","minLength":1,"maxLength":512},"manuscript_truth_release_ref":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},"manuscript_truth_release_digest":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},"formal_claim_count":{"type":"integer","minimum":1,"maximum":512},"informal_item_count":{"type":"integer","minimum":0,"maximum":2048},"formal_claims_certified":{"const":true},"exact_release_coherent":{"const":true},"epistemic_boundaries_explicit":{"const":true},"status":{"const":"eligible"}}}

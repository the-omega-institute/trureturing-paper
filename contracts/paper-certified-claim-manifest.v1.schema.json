{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"paper-certified-claim-manifest.v1","title":"paper-certified-claim-manifest.v1","description":"A closed Paper manifest whose formal theorem, lemma, and corollary entries are reconstructed from Paper-certified claims and rechecked for simultaneous presence in one selected truth release. Conjectures and informal exposition occupy a disjoint typed array.","type":"object","additionalProperties":false,"required":["schema","manuscript_plan_ref","paper_id","title","manuscript_truth_release_ref","manuscript_truth_release_digest","source_repo","source_commit","source_tree","formal_claims","informal_exposition","formal_claim_count","informal_item_count","manifest_status"],"properties":{"schema":{"const":"paper-certified-claim-manifest.v1"},"manuscript_plan_ref":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},"paper_id":{"type":"string","minLength":1,"maxLength":512},"title":{"type":"string","minLength":1,"maxLength":1024},"manuscript_truth_release_ref":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},"manuscript_truth_release_digest":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},"source_repo":{"const":"the-omega-institute/trureturing"},"source_commit":{"type":"string","pattern":"^[0-9a-f]{40}$"},"source_tree":{"type":"string","pattern":"^[0-9a-f]{40}$"},"formal_claims":{"type":"array","minItems":1,"maxItems":512,"items":{"type":"object","additionalProperties":false,"required":["claim_id","latex_label","claim_kind","role_in_argument","certified_claim_ref","certification_wait_ref","formalization_result_ref","formalization_request_ref","selection_ref","paper_research_input_ref","candidate_paper_ref","literature_research_ref","gid","lean_declaration","statement","requested_statement_digest","statement_id","original_certifying_release_ref","original_certifying_release_digest","axiom_closure","proof_status","epistemic_status"],"properties":{"claim_id":{"type":"string","pattern":"^[A-Za-z][A-Za-z0-9_.:-]{0,127}$"},"latex_label":{"type":"string","pattern":"^[A-Za-z][A-Za-z0-9_.-]*:[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"},"claim_kind":{"type":"string","enum":["theorem","lemma","proposition","corollary"]},"role_in_argument":{"type":"string","minLength":1,"maxLength":8192},"certified_claim_ref":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},"certification_wait_ref":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},"formalization_result_ref":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},"formalization_request_ref":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},"selection_ref":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},"paper_research_input_ref":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},"candidate_paper_ref":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},"literature_research_ref":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},"gid":{"type":"string","pattern":"^D[0-9]+/S[0-9]+/[A-Za-z0-9_-]+(?:/[A-Za-z0-9_-]+)*(?:\\.[A-Za-z_][A-Za-z0-9_']*)?$"},"lean_declaration":{"type":"string","minLength":1,"maxLength":1024},"statement":{"type":"string","minLength":1,"maxLength":16384},"requested_statement_digest":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},"statement_id":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},"original_certifying_release_ref":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},"original_certifying_release_digest":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},"axiom_closure":{"type":"array","uniqueItems":true,"items":{"type":"string","enum":["Classical.choice","Quot.sound","propext"]}},"proof_status":{"const":"certified"},"epistemic_status":{"const":"certified"}}}},"informal_exposition":{"type":"array","maxItems":2048,"items":{"type":"object","additionalProperties":false,"required":["item_id","latex_label","item_kind","text","text_digest","epistemic_status"],"properties":{"item_id":{"type":"string","pattern":"^[A-Za-z][A-Za-z0-9_.:-]{0,127}$"},"latex_label":{"type":"string","pattern":"^[A-Za-z][A-Za-z0-9_.-]*:[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"},"item_kind":{"type":"string","enum":["conjecture","definition","example","remark","motivation","discussion","limitation"]},"text":{"type":"string","minLength":1,"maxLength":32768},"text_digest":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},"epistemic_status":{"type":"string","enum":["conjectured","explicitly-informal"]}},"allOf":[{"if":{"properties":{"item_kind":{"const":"conjecture"}},"required":["item_kind"]},"then":{"properties":{"epistemic_status":{"const":"conjectured"}}},"else":{"properties":{"epistemic_status":{"const":"explicitly-informal"}}}}]}},"formal_claim_count":{"type":"integer","minimum":1,"maximum":512},"informal_item_count":{"type":"integer","minimum":0,"maximum":2048},"manifest_status":{"const":"closed"}}}

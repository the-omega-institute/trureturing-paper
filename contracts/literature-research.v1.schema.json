{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "literature-research.v1",
  "title": "Library-before-proof literature research",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "claim", "queries_run", "related_work", "novelty_assessment", "rationale"],
  "properties": {
    "schema": { "const": "literature-research.v1" },
    "claim": { "type": "string", "minLength": 1 },
    "queries_run": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "related_work": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "authors", "venue", "year", "url", "relation", "verification_status"],
        "properties": {
          "title": { "type": "string", "minLength": 1 },
          "authors": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "venue": { "type": "string", "minLength": 1 },
          "year": { "type": "integer", "minimum": 1000, "maximum": 9999 },
          "url": { "type": "string", "format": "uri" },
          "relation": { "enum": ["prior-art", "related", "independent"] },
          "verification_status": { "enum": ["verified", "unverified"] }
        }
      }
    },
    "novelty_assessment": { "enum": ["novel", "known", "partial"] },
    "rationale": { "type": "string", "minLength": 1 }
  }
}

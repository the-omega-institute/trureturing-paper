{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "literature-research.v1",
  "title": "Library-before-proof literature research",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "claim", "structural_context", "queries_run", "related_work", "novelty_assessment", "rationale"],
  "properties": {
    "schema": { "const": "literature-research.v1" },
    "claim": { "type": "string", "minLength": 1 },
    "structural_context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["availability", "truth_release_digest", "algorithm_profile_digest", "producer_commit", "key_nodes", "advisory"],
      "properties": {
        "availability": { "enum": ["certified", "unavailable"] },
        "truth_release_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "algorithm_profile_digest": {
          "anyOf": [
            { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
            { "type": "null" }
          ]
        },
        "producer_commit": {
          "anyOf": [
            { "type": "string", "pattern": "^[0-9a-f]{40}$" },
            { "type": "null" }
          ]
        },
        "key_nodes": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["node_id", "in_degree", "out_degree", "min_depth", "max_depth", "ancestor_count", "descendant_count", "descendant_cost", "normalized_reach", "dependency_betweenness"],
            "properties": {
              "node_id": { "type": "string", "minLength": 1 },
              "in_degree": { "type": "string", "pattern": "^(0|[1-9][0-9]*)$" },
              "out_degree": { "type": "string", "pattern": "^(0|[1-9][0-9]*)$" },
              "min_depth": { "type": "string", "pattern": "^(0|[1-9][0-9]*)$" },
              "max_depth": { "type": "string", "pattern": "^(0|[1-9][0-9]*)$" },
              "ancestor_count": { "type": "string", "pattern": "^(0|[1-9][0-9]*)$" },
              "descendant_count": { "type": "string", "pattern": "^(0|[1-9][0-9]*)$" },
              "descendant_cost": { "type": "string", "pattern": "^(0|[1-9][0-9]*)$" },
              "normalized_reach": { "$ref": "#/$defs/exactRational" },
              "dependency_betweenness": { "$ref": "#/$defs/exactRational" }
            }
          }
        },
        "advisory": { "type": "string", "minLength": 1 }
      }
    },
    "queries_run": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "related_work": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "authors", "venue", "year", "url", "relation", "verification_status"],
        "properties": {
          "title": { "type": "string", "minLength": 1 },
          "authors": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "venue": { "type": "string", "minLength": 1 },
          "year": { "type": "integer", "minimum": 1000, "maximum": 9999 },
          "url": { "type": "string", "format": "uri" },
          "relation": { "enum": ["prior-art", "related", "independent"] },
          "verification_status": { "enum": ["verified", "unverified"] }
        }
      }
    },
    "novelty_assessment": { "enum": ["novel", "known", "partial"] },
    "rationale": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "exactRational": {
      "type": "object",
      "additionalProperties": false,
      "required": ["numerator", "denominator"],
      "properties": {
        "numerator": { "type": "string", "pattern": "^(0|[1-9][0-9]*)$" },
        "denominator": { "type": "string", "pattern": "^[1-9][0-9]*$" }
      }
    }
  }
}

<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <OutputType>Exe</OutputType>
    <StartupObject>Trureturing.Paper.Tests.LocalTestRunner</StartupObject>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.0.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Trureturing.Paper.Core/Trureturing.Paper.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="../fixtures/**/*" Link="fixtures/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../fixtures-real/**/*" Link="fixtures-real/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../Papers/recipes/synthetic-minimal.recipe.v1.json" Link="fixtures/synthetic-minimal.recipe.v1.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
